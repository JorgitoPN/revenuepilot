NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL / Supabase pooler compatible
# Prefer a dedicated RevenuePilot project. Do not reuse BarLive.
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Stripe TEST first. A restricted key (rk_test_...) is preferred when its permissions cover Checkout/Product reads/writes used by the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-this-to-at-least-32-random-characters
DOWNLOAD_SECRET=change-this-too-to-at-least-32-random-characters

# Optional
DEFAULT_MARKET=US

# Autopilot
AUTO_THEMES=contractors,local services,professional workflows
AUTO_LANGUAGES=es,en
AUTO_MIN_SCORE=80
AUTO_GENERATE_PRODUCTS=false
AUTO_PUBLISH_PRODUCTS=false
